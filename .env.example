# Optional: copy to .env to override the defaults in docker-compose.yml.
# All values here are placeholders for local testing, never real secrets.
# NODE_ENV and PORT are fixed by the compose file and images (production, 3000).

# test: migrate installs the function behind POST /api/v1/_test/reset, and the endpoint works.
# Anything else: migrate drops that function, and the endpoint answers 404.
APP_ENV=development

POSTGRES_DB=inblack_topup
POSTGRES_USER=inblack_user
POSTGRES_PASSWORD=change_this_local_password

# Password of the inblack_app role, which api and worker connect as. It has no superuser
# rights and owns no tables. The migrate service sets this password on the role.
APP_DB_PASSWORD=change_this_local_app_password
DATABASE_URL=postgresql://inblack_app:change_this_local_app_password@postgres:5432/inblack_topup

# Only migrate uses the table owner (POSTGRES_USER). Do not point DATABASE_URL at it.
MIGRATE_DATABASE_URL=postgresql://inblack_user:change_this_local_password@postgres:5432/inblack_topup

REDIS_URL=redis://redis:6379

MOCK_PAY_URL=http://mock-pay:4010
MOCK_GAME_URL=http://mock-game:4020

# What the customer's browser opens, so these are host addresses, not compose names.
MOCK_PAY_PUBLIC_URL=http://localhost:4010
WEB_PUBLIC_URL=http://localhost:3000

# Test value published in the assignment; the review team signs webhooks with it.
PAYMENT_WEBHOOK_SECRET=whsec_test_inblackm_2026

# HMAC key for the events_token that POST /api/v1/orders/track returns and that
# GET /api/v1/orders/{id}/events?token= checks. At least 16 characters. Test value only.
ORDER_EVENTS_TOKEN_SECRET=test_only_order_events_secret_change_me

ORDER_TTL_SECONDS=900
EXPIRY_SWEEP_INTERVAL_MS=5000

ADMIN_SESSION_TTL_SECONDS=28800
# Sets Secure on the admin cookie. Compose serves plain http on localhost, so it is off here.
COOKIE_SECURE=false

# Worker. docs/adr/0002-webhook-and-fulfillment-idempotency.md explains how these fit together.
# OUTBOX_LEASE_MS must stay above POST timeout + settle + GET timeout, or the worker refuses to start.
OUTBOX_POLL_MS=1000
OUTBOX_CONCURRENCY=20
OUTBOX_LEASE_MS=25000
OUTBOX_BACKOFF_CAP_MS=60000
RECOVERY_SWEEP_MS=30000
FULFILLMENT_POST_TIMEOUT_MS=8000
FULFILLMENT_GET_TIMEOUT_MS=8000
FULFILLMENT_SETTLE_MS=5000
FULFILLMENT_MAX_ATTEMPTS=5
FULFILLMENT_MAX_POSTS=3
FULFILLMENT_BACKOFF_BASE_MS=1000
REFUND_MAX_ATTEMPTS=8
REFUND_BACKOFF_BASE_MS=2000

WEBHOOK_URL=http://proxy/api/v1/webhooks/payment

# mock-game failure behaviour (rates are 0 to 1)
FAIL_RATE=0
TIMEOUT_RATE=0
SUCCESS_BUT_TIMEOUT_RATE=0
LATENCY_MS=0
